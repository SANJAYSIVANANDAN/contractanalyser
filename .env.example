# Copy to .env and fill in. Inside Docker, hostnames are the compose service names.
POSTGRES_USER=docupilot
POSTGRES_PASSWORD=docupilot
POSTGRES_DB=docupilot

DATABASE_URL=postgresql+psycopg://docupilot:docupilot@postgres:5432/docupilot
REDIS_URL=redis://redis:6379/0

UPLOAD_DIR=/app/uploads
OPENAI_API_KEY=sk-your-key-here

# Signs login JWTs. Change this to a long random value for anything beyond local dev.
JWT_SECRET=dev-secret-change-me

# Optional: LLM observability (traces for rag.py and contract_analyzer.py). Leave blank to disable.
# Host must match the region your Langfuse project was created in:
# EU (default) = https://cloud.langfuse.com, US = https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
