# Copy to .env and fill in. Inside Docker, hostnames are the compose service names.
POSTGRES_USER=docupilot
POSTGRES_PASSWORD=docupilot
POSTGRES_DB=docupilot

DATABASE_URL=postgresql+psycopg://docupilot:docupilot@postgres:5432/docupilot
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

UPLOAD_DIR=/app/uploads
OPENAI_API_KEY=sk-your-key-here
